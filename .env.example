# ── Blockchain ────────────────────────────────────────────────────────────────
# Private key (no 0x prefix) for the deployer/owner wallet
PRIVATE_KEY=your_private_key_here

# RPC endpoints
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Etherscan verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Deployed contract addresses (filled in by setup.ts output)
REWARD_TOKEN_ADDRESS=
REPUTATION_TRACKER_ADDRESS=
AGENT_REGISTRY_ADDRESS=
REWARD_DISTRIBUTOR_ADDRESS=

# Uniswap v4 PoolManager address (required only for ReputationHook deployment)
POOL_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Evaluator treasury wallet (defaults to deployer if not set)
EVALUATOR_TREASURY_ADDRESS=

# ── Backend / AI ──────────────────────────────────────────────────────────────
# Claude (Anthropic) — HighQualityModelAgent
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI — FastModelAgent + TaskClassifier (Grok)
# https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# DeepSeek — BalancedModelAgent (DeepSeek V3)
# https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Venice.ai — Council judges (Llama 3.3 70B, privacy-first inference)
# https://venice.ai/settings/api
VENICE_API_KEY=your_venice_api_key_here

# 0G Storage
# Testnet faucet: https://faucet.0g.ai  |  Docs: https://docs.0g.ai
OG_PRIVATE_KEY=0x_your_wallet_private_key
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_STORAGE_ENDPOINT=https://indexer-storage-testnet-turbo.0g.ai

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_AGENT_REGISTRY_ADDRESS=
VITE_REWARD_DISTRIBUTOR_ADDRESS=
VITE_REPUTATION_TRACKER_ADDRESS=
VITE_REWARD_TOKEN_ADDRESS=
VITE_RPC_URL=http://127.0.0.1:8545
